{
  "name": "aether-gemini-companion-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cap:sync": "cap sync ios",
    "cap:add": "cap add ios",
    "electron": "electron electron/main.cjs",
    "desktop": "vite build && electron electron/main.cjs",
    "build:desktop": "vite build && electron-builder --win --x64",
    "build:desktop:dir": "vite build && electron-builder --dir"
  },
  "build": {
    "appId": "com.seif.aicompanion.desktop",
    "productName": "Seif AI Companion",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/app-icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Seif AI Companion"
    }
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/camera": "^7.0.5",
    "@capacitor/core": "^7.0.1",
    "@capacitor/ios": "^7.0.1",
    "@capacitor/local-notifications": "^7.0.7",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "vite": "^6.2.0"
  }
}
