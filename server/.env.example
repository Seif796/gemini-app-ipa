# Server Port (Render and Railway inject PORT automatically)
PORT=5000

# JWT Authentication Secret Key
JWT_SECRET=super-secret-gemini-ios-companion-key-2026-production

# Default Gemini API Key (Optional if users provide their key in iOS App Settings)
# Paste your Gemini API key from https://aistudio.google.com/app/apikey here:
GEMINI_API_KEY=
